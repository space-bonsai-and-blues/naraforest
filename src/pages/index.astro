---
import Terrain from "../components/Terrain.astro";
import WaymarkerIcon from "../components/WaymarkerIcon.astro";
import MapLegend from "../components/MapLegend.astro";
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>nara forest</title>
    <style>
      html, body {
        margin: 0;
        background: #f7f6f1;
      }
    </style>
  </head>
  <body>
    <Terrain>
<MapLegend x={486} y={15} />
      <WaymarkerIcon
        x={176}
        y={713}
        blazeColor="#4a7fc9"
        symbol="thread"
        label="thought trail"
        href="https://aiscout.naratends.com/"
      />
      <WaymarkerIcon
        x={455}
        y={656}
        blazeColor="#d9a13a"
        symbol="dots"
        label="trailhead"
        href="https://trailhead.naraforest.com/"
      />
      <WaymarkerIcon
        x={238}
        y={350}
        blazeColor="#3f9e83"
        symbol="grid"
        label="when in complexity"
        href="#"
      />
      <WaymarkerIcon
        x={330}
        y={1200}
        blazeColor="#c96f8c"
        symbol="dots3"
        label="secret of life"
        href="#"
      />
    </Terrain>
  </body>
</html>
