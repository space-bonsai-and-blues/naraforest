---
// Static background: sky, the two green terrain shapes, ponds, creek,
// and edge trees. No interactivity lives here — that's all in
// WaymarkerIcon. Anything passed as children renders on top, inside the
// same coordinate space (viewBox 0 0 680 1450).
//
// Everything below the sky rect is wrapped in one <g transform="translate(0,70)">
// group. That single offset is what opens extra sky above the artwork —
// every existing coordinate (trees, ponds, creek, both bubbles, and
// anything passed in via <slot />, i.e. all waymarker icons + the map
// legend) stays exactly as it was before; the whole group just moves
// down as one block.
---
<svg
  viewBox="0 0 680 1450"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="A forest terrain with paths to each nara forest app"
  class="nara-forest-terrain"
>
  <defs>
    <linearGradient id="nf-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#cfe4f7" />
      <stop offset="100%" stop-color="#f7f6f1" />
    </linearGradient>
  </defs>
  <rect x="0" y="0" width="680" height="1450" fill="url(#nf-sky)" />
  <g transform="translate(0, 70)">
    <text x="40" y="50" font-family="Georgia, serif" font-size="21" font-weight="500" fill="#33322d">nara forest</text>
    <!-- back bubble: upright, rounder — extended downward past the old
         y=875 cutoff into the new lower terrain, same irregular-curve
         style as the rest of the shape -->
    <path
      d="M85,875 C58,760 55,655 80,565 C105,475 155,425 205,375 C250,330 270,205 305,175 C340,148 385,130 435,131 C485,132 515,150 545,168 C595,195 625,260 615,350 C605,440 620,560 605,680 C598,760 605,830 580,875 C615,930 630,985 600,1040 C578,1080 545,1100 555,1150 C565,1195 600,1225 580,1275 C562,1315 520,1340 470,1355 C410,1372 340,1378 270,1370 C205,1362 150,1345 120,1310 C90,1270 75,1225 90,1180 C105,1135 95,1090 75,1045 C58,1000 65,955 78,915 C82,900 84,887 85,875 Z"
      fill="#bcd9a0"
      opacity="0.9"
    />
    <!-- front bubble: smaller, irregular oval, tilted ~30 degrees -->
    <path
      d="M350,232 C400,238 452,270 480,325 C505,375 500,440 515,500 C528,555 540,610 520,670 C505,715 490,755 485,795 C478,825 460,850 420,868 C375,885 340,880 300,865 C255,848 220,820 200,780 C180,740 175,700 168,650 C160,590 150,530 155,470 C160,405 175,350 200,315 C222,283 280,258 350,232 Z"
      fill="#8fbf6a"
      opacity="0.92"
      transform="rotate(30 340 560)"
    />
    <!-- edge trees, four per side (original) -->
    <polygon points="29,224 61,224 45,184" fill="#5a9e46" /><rect x="42" y="224" width="6" height="14" fill="#7a6248" />
    <polygon points="24,404 56,404 40,364" fill="#5a9e46" /><rect x="37" y="404" width="6" height="14" fill="#7a6248" />
    <polygon points="24,584 56,584 40,544" fill="#5a9e46" /><rect x="37" y="584" width="6" height="14" fill="#7a6248" />
    <polygon points="19,704 51,704 35,664" fill="#5a9e46" /><rect x="32" y="704" width="6" height="14" fill="#7a6248" />
    <polygon points="619,254 651,254 635,214" fill="#5a9e46" /><rect x="632" y="254" width="6" height="14" fill="#7a6248" />
    <polygon points="629,434 661,434 645,394" fill="#5a9e46" /><rect x="642" y="434" width="6" height="14" fill="#7a6248" />
    <polygon points="624,614 656,614 640,574" fill="#5a9e46" /><rect x="637" y="614" width="6" height="14" fill="#7a6248" />
    <polygon points="624,734 656,734 640,694" fill="#5a9e46" /><rect x="637" y="734" width="6" height="14" fill="#7a6248" />
    <!-- new trees in the extended lower terrain: 1 left, 2 right -->
    <polygon points="19,960 51,960 35,920" fill="#5a9e46" /><rect x="32" y="960" width="6" height="14" fill="#7a6248" />
    <polygon points="624,950 656,950 640,910" fill="#5a9e46" /><rect x="637" y="950" width="6" height="14" fill="#7a6248" />
    <polygon points="624,1150 656,1150 640,1110" fill="#5a9e46" /><rect x="637" y="1150" width="6" height="14" fill="#7a6248" />
    <!-- creek: short, points inward toward pond #1 without reaching it -->
    <path
      d="M600,150 C575,178 545,190 520,208 C495,225 480,250 485,290 C488,305 493,318 498,331"
      stroke="#7fb8e0"
      stroke-width="9"
      stroke-linecap="round"
      fill="none"
      opacity="0.85"
    />
    <!-- pond #1 -->
    <path
      d="M238,650 C242,630 260,624 275,628 C292,633 300,620 298,640 C296,658 304,662 292,672 C280,682 260,680 248,668 C238,660 234,655 238,650 Z"
      fill="#7fb8e0"
      opacity="0.85"
    />
    <!-- pond #2 -->
    <path
      d="M451,470 C456,440 490,428 515,435 C540,442 550,460 546,480 C542,500 550,508 530,512 C510,516 480,510 460,495 C448,486 446,478 451,470 Z"
      fill="#7fb8e0"
      opacity="0.85"
    />
    <slot />
  </g>
</svg>
<style>
  .nara-forest-terrain {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
