---
// The one-time welcome sign near the arrival point: same trunk as the
// app markers, but it previews what's ahead rather than linking anywhere
// itself. "simply wonders" is deliberately left off — it's meant to be
// stumbled into, not signposted.
import { TRUNK_PATH } from "../lib/waymarker-shapes";

interface Props {
  x: number;
  y: number;
}

const { x, y } = Astro.props;

const lines = [
  "Thought Trail — Clear your thoughts.",
  "Trailhead — Weigh what matters.",
  "Logic Models — See the shape of it.",
];
---

<g class="welcome-signpost" transform={`translate(${x}, ${y})`}>
  <path d={TRUNK_PATH} fill="#7a6248" />
  <line x1="0" y1="-118" x2="0" y2="-110" stroke="#c9c7bd" stroke-width="1" stroke-dasharray="1,3" />
  <rect x="-95" y="-210" width="190" height="92" rx="14" fill="#faf8f2" stroke="#ddd" stroke-width="0.5" />
  {lines.map((line, i) => (
    <text x="0" y={-186 + i * 26} text-anchor="middle" font-size="12" fill="#33322d">{line}</text>
  ))}
</g>
