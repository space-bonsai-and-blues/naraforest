---
interface LegendItem {
  color: string;
  name: string;
  caption: string;
}
interface Props {
  x: number;
  y: number;
}
const { x, y } = Astro.props;
const items: LegendItem[] = [
  { color: "#4a7fc9", name: "Thought Trail", caption: "clear your thoughts" },
  { color: "#d9a13a", name: "Trailhead", caption: "weigh what matters" },
  { color: "#3f9e83", name: "When in Complexity", caption: "see the shape of it" },
  { color: "#c96f8c", name: "Secret of Life", caption: "three small things" },
];
const cardWidth = 140;
const rowHeight = 34;
const paddingY = 18;
const cardHeight = paddingY * 2 + rowHeight * (items.length - 1) + 22;
---
<g class="map-legend" transform={`translate(${x}, ${y})`}>
  <rect
    width={cardWidth}
    height={cardHeight}
    rx="12"
    fill="#faf8f2"
    stroke="#ddd"
    stroke-width="0.5"
    opacity="0.95"
  />
{items.map((item, i) => {
    const rowY = paddingY + i * rowHeight;
    return (
      <g transform={`translate(16, ${rowY})`}>
        <circle cx="0" cy="0" r="4.5" fill={item.color} />
        <text
          x="12"
          y="4"
          font-family="-apple-system, system-ui, 'Segoe UI', sans-serif"
          font-size="13"
          font-weight="600"
          fill="#33322d"
        >{item.name}</text>
        <text
          x="12"
          y="18"
          font-family="-apple-system, system-ui, 'Segoe UI', sans-serif"
          font-size="10"
          font-weight="400"
          fill="#8a8880"
        >{item.caption}</text>
      </g>
    );
  })}
</g>
